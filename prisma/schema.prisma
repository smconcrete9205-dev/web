// Prisma schema for the SM Concrete Products admin panel.
// Supabase Postgres. DATABASE_URL = pooled connection (port 6543, pgbouncer) used
// at runtime on serverless; DIRECT_URL = direct connection (port 5432) used by
// `prisma db push` / migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  /// JSON-encoded string[] — paragraphs of the full description
  description      String
  /// JSON-encoded string[] — bullet list of features
  features         String
  /// JSON-encoded string[] — bullet list of applications
  applications     String
  /// JSON-encoded { label: string; value: string }[]
  specs            String
  /// JSON-encoded { src: string; alt: string }[]
  images           String
  seoTitle         String
  seoDescription   String
  /// JSON-encoded string[]
  seoKeywords      String
  /// Billing defaults used to auto-fill invoice / challan lines (never shown on the public site).
  hsnCode          String   @default("6810")
  unit             String   @default("Nos")
  gstRate          Float    @default(18)
  /// Default selling rate per unit, in paise. 0 = not set.
  ratePaise        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  phone      String
  product    String
  quantity   String
  message    String
  sourcePage String
  /// "new" | "contacted" | "closed"
  status     String   @default("new")
  createdAt  DateTime @default(now())
}

/// Single-row table holding editable sitewide contact/company details.
model SiteSettings {
  id                Int      @id @default(1)
  phone             String
  phoneDisplay      String
  whatsappNumber    String
  email             String
  addressStreet     String
  addressLocality   String
  addressRegion     String
  addressPostalCode String
  mapEmbedSrc       String
  /// Our own GSTIN — used on invoices and to determine CGST+SGST vs IGST
  /// split (intra-state vs inter-state) against a party's state.
  gstin             String   @default("")
  updatedAt         DateTime @updatedAt
}

/// Single-row (id=1) trial/licence state, controlled from /superadmin.
/// After the licence expires the admin panel stays open for products, leads
/// and traffic, but ERP writes (invoices, payments, challans, ...) are locked.
model License {
  id          Int       @id @default(1)
  trialEndsAt DateTime
  /// Set when the client has paid; licence is active until this date.
  paidUntil   DateTime?
  priceInr    Int       @default(3999)
  /// Optional custom message shown on the lock screen.
  message     String    @default("")
  updatedAt   DateTime  @updatedAt
}

/// Customers and vendors used across invoices, purchase orders, and payments.
model Party {
  id                  String   @id @default(cuid())
  /// "CUSTOMER" | "VENDOR" | "BOTH"
  type                String
  name                String
  gstin               String?
  pan                 String?
  phone               String
  email               String?
  addressStreet       String?
  addressLocality     String?
  /// State — used to determine CGST+SGST (same state as us) vs IGST (different state) on invoices.
  addressRegion       String?
  addressPostalCode   String?
  /// Ledger opening balance in paise. Positive = party owes us (receivable),
  /// negative = we owe the party (payable).
  openingBalancePaise Int      @default(0)
  notes               String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  invoices Invoice[]
  payments Payment[]
  challans Challan[]
  expenses Expense[]
}

/// GST sales invoice raised against a customer.
model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  partyId       String
  party         Party     @relation(fields: [partyId], references: [id])
  invoiceDate   DateTime  @default(now())
  dueDate       DateTime?
  /// JSON-encoded { description, hsnCode, quantity, unit, rate, gstRate }[]
  items         String
  /// State the goods/services are supplied to — determines CGST+SGST vs IGST.
  placeOfSupply String
  subtotalPaise Int
  cgstPaise     Int       @default(0)
  sgstPaise     Int       @default(0)
  igstPaise     Int       @default(0)
  totalPaise    Int
  /// "DRAFT" | "SENT" | "PAID" | "PARTIALLY_PAID" | "OVERDUE" | "CANCELLED"
  status        String    @default("DRAFT")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments Payment[]
  challans Challan[]
}

/// Money received from a customer (IN) or paid to a vendor (OUT). An IN payment
/// may be linked to an invoice, which drives the invoice's paid/partial status.
model Payment {
  id          String   @id @default(cuid())
  partyId     String
  party       Party    @relation(fields: [partyId], references: [id])
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  /// "IN" (received from customer) | "OUT" (paid to vendor)
  direction   String   @default("IN")
  amountPaise Int
  paymentDate DateTime @default(now())
  /// "CASH" | "UPI" | "BANK" | "CHEQUE" | "OTHER"
  mode        String   @default("CASH")
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([partyId])
  @@index([invoiceId])
}

/// Business expense (raw material, labour, transport, diesel, ...).
model Expense {
  id          String   @id @default(cuid())
  category    String
  description String?
  amountPaise Int
  expenseDate DateTime @default(now())
  /// "CASH" | "UPI" | "BANK" | "CHEQUE" | "OTHER"
  mode        String   @default("CASH")
  partyId     String?
  party       Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([expenseDate])
}

/// Delivery challan — record of goods dispatched to a customer.
model Challan {
  id              String   @id @default(cuid())
  challanNumber   String   @unique
  partyId         String
  party           Party    @relation(fields: [partyId], references: [id])
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  challanDate     DateTime @default(now())
  vehicleNo       String?
  driverName      String?
  deliveryAddress String?
  /// JSON-encoded { description, quantity, unit }[]
  items           String
  notes           String?
  createdAt       DateTime @default(now())

  @@index([partyId])
}

/// First-party website analytics: page views and click events (call / WhatsApp / quote).
model SiteEvent {
  id        String   @id @default(cuid())
  /// "view" | "call" | "whatsapp" | "quote_submit"
  type      String
  path      String
  referrer  String?
  /// Traffic source bucket: "google" | "direct" | "social" | "other" | utm_source
  source    String?
  device    String?
  visitorId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}
