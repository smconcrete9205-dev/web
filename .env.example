# Public site URL — used for canonical URLs, JSON-LD, and sitemap generation.
# Set this to your real production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://www.smconcreteproducts.com
SITE_URL=https://www.smconcreteproducts.com

# Database (SQLite file — fine for self-hosted/VPS deployment). If you deploy to
# a serverless platform with an ephemeral filesystem, point this at a hosted
# Postgres/MySQL database instead and update prisma/schema.prisma's provider.
DATABASE_URL="file:./dev.db"

# Admin panel login (see /admin). Change these before deploying anywhere real.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Random secret used to sign the admin session cookie — generate a long random
# string (e.g. `openssl rand -hex 32`) and keep it secret.
SESSION_SECRET=replace-with-a-long-random-string

# ERP integration (used later inside src/lib/leads.ts — not read anywhere yet)
# ERP_LEADS_ENDPOINT=
# ERP_API_KEY=
