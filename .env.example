# Public site URL — used for canonical URLs, JSON-LD, and sitemap generation.
# Set this to your real production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://www.smconcreteproducts.com
SITE_URL=https://www.smconcreteproducts.com

# Supabase Postgres (Project Settings > Database > Connection string).
# DATABASE_URL = Transaction pooler (port 6543) — runtime. Append ?pgbouncer=true
# DIRECT_URL   = Direct/Session connection (port 5432) — prisma db push / seed.
# Special chars in the DB password must be URL-encoded.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Storage (product image uploads). Project Settings > API.
# Service-role key is SERVER-ONLY — never prefix with NEXT_PUBLIC_.
# Create a PUBLIC bucket named product-images (or set SUPABASE_STORAGE_BUCKET).
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET=product-images

# Admin panel login (see /admin). Change these before deploying anywhere real.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Random secret used to sign the admin session cookie — generate a long random
# string (e.g. `openssl rand -hex 32`) and keep it secret.
SESSION_SECRET=replace-with-a-long-random-string

# Lead email alerts (Gmail SMTP). SMTP_PASS = Google "App Password"
# (Google Account > Security > 2-Step Verification > App passwords), NOT the normal password.
SMTP_USER=smconcrete9205@gmail.com
SMTP_PASS=your-16-char-app-password
LEAD_NOTIFY_EMAIL=smconcrete9205@gmail.com

# ERP integration (used later inside src/lib/leads.ts — not read anywhere yet)
# ERP_LEADS_ENDPOINT=
# ERP_API_KEY=
